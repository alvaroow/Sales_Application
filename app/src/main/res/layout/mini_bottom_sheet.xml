<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mini_bottom_sheet"
    android:layout_width="match_parent"
    android:layout_height="60dp"
    android:layout_marginHorizontal="16dp"
    android:layout_marginBottom="16dp"
    android:visibility="gone"
    app:cardCornerRadius="12dp"
    app:cardElevation="8dp"
    app:cardBackgroundColor="@color/text_main">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvMiniInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="2 Item | Rp 50.000"
            android:textColor="@color/bg_app"
            android:textStyle="bold"
            android:textSize="14sp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOpenCart"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="Lihat Cart"
            android:textColor="@color/text_main"
            android:textStyle="bold"
            app:backgroundTint="@color/secondary"
            app:cornerRadius="12dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:layout_marginLeft="22dp"
            android:elevation="0dp"/>
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
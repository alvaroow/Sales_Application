<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cvCARD_PRODUK"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="10dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="18dp"
    app:cardElevation="5dp"
    app:cardBackgroundColor="#FFFFFF">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp">

        <!-- IMAGE -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/iconCardProduk"
            android:layout_width="60dp"
            android:layout_height="60dp"
            app:cardCornerRadius="14dp"
            app:cardBackgroundColor="#F1F5F9"
            app:cardElevation="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/ivProduk"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="12dp"
                android:src="@drawable/product"
                android:tint="#1E293B"/>
        </com.google.android.material.card.MaterialCardView>

        <!-- NAMA -->
        <TextView
            android:id="@+id/tvNamaProduk"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Nama Produk"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="#111827"
            android:layout_marginStart="12dp"
            app:layout_constraintStart_toEndOf="@id/iconCardProduk"
            app:layout_constraintTop_toTopOf="@id/iconCardProduk"
            app:layout_constraintEnd_toStartOf="@id/chipStatusProduk"/>

        <!-- HARGA -->
        <TextView
            android:id="@+id/tvHargaProduk"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Rp 0"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#1E293B"
            android:layout_marginStart="12dp"
            app:layout_constraintStart_toEndOf="@id/iconCardProduk"
            app:layout_constraintTop_toBottomOf="@id/tvNamaProduk"
            app:layout_constraintEnd_toStartOf="@id/chipStatusProduk"/>

        <!-- STATUS -->
        <com.google.android.material.chip.Chip
            android:id="@+id/chipStatusProduk"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:text="Aktif"
            android:textSize="12sp"
            android:textStyle="bold"
            app:chipCornerRadius="8dp"
            app:chipBackgroundColor="#DCFCE7"
            app:chipStrokeWidth="0dp"
            app:chipIconVisible="false"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tvHargaProduk"/>

        <!-- KATEGORI (ATAS BAWAH STYLE) -->
        <TextView
            android:id="@+id/tvKategori"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Kategori: -"
            android:textSize="12sp"
            android:textColor="#6B7280"
            android:layout_marginStart="12dp"
            android:layout_marginTop="10dp"
            app:layout_constraintStart_toEndOf="@id/iconCardProduk"
            app:layout_constraintTop_toBottomOf="@id/tvHargaProduk"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- CABANG -->
        <TextView
            android:id="@+id/tvCabang"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Cabang: -"
            android:textSize="12sp"
            android:textColor="#6B7280"
            android:layout_marginStart="12dp"
            android:layout_marginTop="4dp"
            app:layout_constraintStart_toEndOf="@id/iconCardProduk"
            app:layout_constraintTop_toBottomOf="@id/tvKategori"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- STOK -->
        <TextView
            android:id="@+id/tvStokProduk"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Stok: 0"
            android:textSize="12sp"
            android:textColor="#9CA3AF"
            android:layout_marginTop="10dp"
            app:layout_constraintStart_toStartOf="@id/iconCardProduk"
            app:layout_constraintTop_toBottomOf="@id/tvCabang"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
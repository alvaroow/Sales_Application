<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cvCARD_PRODUK"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="10dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="18dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="#FFFFFF"
    android:foreground="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp">

        <!-- IMAGE PRODUK -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/iconCardProduk"
            android:layout_width="56dp"
            android:layout_height="56dp"
            app:cardCornerRadius="12dp"
            app:cardBackgroundColor="#F1F5F9"
            app:cardElevation="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <ImageView
                android:id="@+id/ivProduk"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="10dp"
                android:src="@drawable/product"
                android:tint="#1E293B"/>
        </com.google.android.material.card.MaterialCardView>

        <!-- NAMA PRODUK -->
        <TextView
            android:id="@+id/tvNamaProduk"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Nama Produk"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="#111827"
            android:layout_marginStart="12dp"
            app:layout_constraintStart_toEndOf="@id/iconCardProduk"
            app:layout_constraintTop_toTopOf="@id/iconCardProduk"
            app:layout_constraintEnd_toStartOf="@id/chipStatusProduk"/>

        <!-- HARGA -->
        <TextView
            android:id="@+id/tvHargaProduk"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Rp 0"
            android:textSize="13sp"
            android:textColor="#6B7280"
            android:layout_marginStart="12dp"
            app:layout_constraintStart_toEndOf="@id/iconCardProduk"
            app:layout_constraintTop_toBottomOf="@id/tvNamaProduk"
            app:layout_constraintEnd_toStartOf="@id/chipStatusProduk"/>

        <!-- STATUS CHIP -->
        <com.google.android.material.chip.Chip
            android:id="@+id/chipStatusProduk"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:text="Aktif"
            android:textSize="12sp"
            android:textStyle="bold"
            app:chipCornerRadius="8dp"
            app:chipBackgroundColor="#DCFCE7"
            app:chipStrokeWidth="0dp"
            app:chipIconVisible="false"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

        <!-- STOK -->
        <TextView
            android:id="@+id/tvStokProduk"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Stok: 0"
            android:textSize="12sp"
            android:textColor="#9CA3AF"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
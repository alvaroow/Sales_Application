<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cvCARD_PRODUK"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="10dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="18dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/bg_surface"> <androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="14dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/iconCardProduk"
        android:layout_width="60dp"
        android:layout_height="60dp"
        app:cardCornerRadius="14dp"
        app:cardBackgroundColor="@color/bg_app"
        app:cardElevation="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/ivProduk"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="12dp"
            android:src="@drawable/product"
            app:tint="@color/text_main" />
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/tvNamaProduk"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Nama Produk"
        android:textStyle="bold"
        android:textSize="16sp"
        android:textColor="@color/text_main"
        android:layout_marginStart="12dp"
        app:layout_constraintStart_toEndOf="@id/iconCardProduk"
        app:layout_constraintTop_toTopOf="@id/iconCardProduk"
        app:layout_constraintEnd_toStartOf="@id/chipStatusProduk"/>

    <TextView
        android:id="@+id/tvHargaProduk"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Rp 0"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/primary"
        android:layout_marginStart="12dp"
        app:layout_constraintStart_toEndOf="@id/iconCardProduk"
        app:layout_constraintTop_toBottomOf="@id/tvNamaProduk"
        app:layout_constraintEnd_toStartOf="@id/chipStatusProduk"/>

    <com.google.android.material.chip.Chip
        android:id="@+id/chipStatusProduk"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:text="Aktif"
        android:textSize="12sp"
        android:textStyle="bold"
        app:chipCornerRadius="8dp"
        app:chipBackgroundColor="@color/green"
        app:chipStrokeWidth="0dp"
        app:chipIconVisible="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tvHargaProduk"/>

    <TextView
        android:id="@+id/tvKategori"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Kategori: -"
        android:textSize="12sp"
        android:textColor="@color/text_secondary"
        android:layout_marginStart="12dp"
        android:layout_marginTop="10dp"
        app:layout_constraintStart_toEndOf="@id/iconCardProduk"
        app:layout_constraintTop_toBottomOf="@id/tvHargaProduk"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/tvCabang"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Cabang: -"
        android:textSize="12sp"
        android:textColor="@color/text_secondary"
        android:layout_marginStart="12dp"
        android:layout_marginTop="4dp"
        app:layout_constraintStart_toEndOf="@id/iconCardProduk"
        app:layout_constraintTop_toBottomOf="@id/tvKategori"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/tvStokProduk"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Stok: 0"
        android:textSize="12sp"
        android:textColor="@color/text_secondary"
        android:layout_marginTop="10dp"
        app:layout_constraintStart_toStartOf="@id/iconCardProduk"
        app:layout_constraintTop_toBottomOf="@id/tvCabang"/>

</androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
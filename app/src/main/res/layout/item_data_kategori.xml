<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cvCARD_KATEGORI"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="10dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="18dp"
    app:cardElevation="2dp"
    app:strokeWidth="0dp"
    android:foreground="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/bg_surface"> <androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="14dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/iconCard"
        android:layout_width="60dp"
        android:layout_height="60dp"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/bg_app"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageView
            android:id="@+id/iviconKategori"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="12dp"
            android:src="@drawable/kategori"
            app:tint="@color/text_main"/> </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/tvCARD_KATEGORI_Nama"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Kategori"
        android:textStyle="bold"
        android:textSize="16sp"
        android:textColor="@color/text_main"
        android:layout_marginStart="12dp"
        app:layout_constraintStart_toEndOf="@id/iconCard"
        app:layout_constraintTop_toTopOf="@id/iconCard"
        app:layout_constraintBottom_toBottomOf="@id/iconCard"
        app:layout_constraintEnd_toStartOf="@id/chipAdd"/>

    <com.google.android.material.chip.Chip
        android:id="@+id/chipAdd"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:text="Aktif"
        android:textSize="12sp"
        android:textStyle="bold"
        app:chipCornerRadius="8dp"
        app:chipBackgroundColor="@color/green"
        app:chipStrokeWidth="0dp"
        app:chipIconVisible="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/iconCard"
        app:layout_constraintBottom_toBottomOf="@id/iconCard"/>

</androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:layout_marginHorizontal="6dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/bg_surface"> <androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp">

    <ImageView
        android:id="@+id/ivIconUser"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/pegawai"
        app:tint="@color/primary"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/tvNamaPegawai"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Nama Pegawai"
        android:textStyle="bold"
        android:textSize="16sp"
        android:textColor="@color/text_main"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toTopOf="@id/ivIconUser"
        app:layout_constraintStart_toEndOf="@id/ivIconUser"
        app:layout_constraintEnd_toStartOf="@id/chipStatusPegawai" />

    <TextView
        android:id="@+id/tvTelpPegawai"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="08123456789"
        android:textSize="13sp"
        android:textColor="@color/text_secondary"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/tvNamaPegawai"
        app:layout_constraintStart_toStartOf="@id/tvNamaPegawai"
        app:layout_constraintEnd_toStartOf="@id/chipStatusPegawai"/>

    <com.google.android.material.chip.Chip
        android:id="@+id/chipStatusPegawai"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:text="Aktif"
        android:textSize="12sp"
        android:textStyle="bold"
        app:chipCornerRadius="8dp"
        app:chipBackgroundColor="@color/green"
        app:chipStrokeWidth="0dp"
        app:chipIconVisible="false"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
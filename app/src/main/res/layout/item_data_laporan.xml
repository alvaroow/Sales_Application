<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="10dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="18dp"
    app:cardElevation="5dp"
    app:cardBackgroundColor="#FFFFFF">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/iconCardLaporan"
            android:layout_width="50dp"
            android:layout_height="50dp"
            app:cardCornerRadius="14dp"
            app:cardBackgroundColor="#F1F5F9"
            app:cardElevation="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="12dp"
                android:src="@drawable/product"
                android:tint="#1E293B"/>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tvIdTransaksi"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="TXN123456789"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="#111827"
            android:layout_marginStart="12dp"
            app:layout_constraintStart_toEndOf="@id/iconCardLaporan"
            app:layout_constraintTop_toTopOf="@id/iconCardLaporan"/>

        <TextView
            android:id="@+id/tvTanggalTransaksi"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="29-05-2026 12:00"
            android:textSize="12sp"
            android:textColor="#6B7280"
            android:layout_marginStart="12dp"
            android:layout_marginTop="4dp"
            app:layout_constraintStart_toEndOf="@id/iconCardLaporan"
            app:layout_constraintTop_toBottomOf="@id/tvIdTransaksi"/>

        <TextView
            android:id="@+id/tvTotalTransaksi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rp 0"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#1E293B"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>